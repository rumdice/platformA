{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/session-start.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/pre-push-build-check.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(*)",
            "PowerShell(*)",
            "Edit(**)",
            "Write(**)",
            "Read(**)",
            "Skill(*)"
        ],
        "additionalDirectories": [
            "C:\\Users\\rumdi\\.claude\\plans"
        ]
    }
}
