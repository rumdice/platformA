{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/user/platformA/.claude/hooks/session-start.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/user/platformA/.claude/hooks/pre-push-build-check.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(git status*)",
            "Bash(git log*)",
            "Bash(git diff*)",
            "Bash(git branch*)",
            "Bash(git fetch*)",
            "Bash(git merge*)",
            "Bash(git add*)",
            "Bash(git commit*)",
            "Bash(git push*)",
            "Bash(git show*)",
            "Bash(find /home/user/platformA*)",
            "Bash(ls*)",
            "Bash(mkdir*)",
            "Bash(rm /home/user/platformA*)",
            "Bash(dotnet build*)",
            "Bash(dotnet test*)",
            "Bash(dotnet run*)",
            "Bash(dotnet ef*)",
            "Bash(docker-compose*)",
            "Bash(sleep*)"
        ]
    }
}
