{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/session-start.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/pre-push-build-check.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(git status*)",
            "Bash(git log*)",
            "Bash(git diff*)",
            "Bash(git branch*)",
            "Bash(git fetch*)",
            "Bash(git merge*)",
            "Bash(git add*)",
            "Bash(git commit*)",
            "Bash(git push*)",
            "Bash(git pull*)",
            "Bash(git checkout*)",
            "Bash(git ls-remote*)",
            "Bash(git show*)",
            "Bash(gh pr*)",
            "Bash(gh repo*)",
            "Bash(find*)",
            "Bash(ls*)",
            "Bash(mkdir*)",
            "Bash(rm*)",
            "Bash(dotnet build*)",
            "Bash(dotnet test*)",
            "Bash(dotnet run*)",
            "Bash(dotnet ef*)",
            "Bash(docker-compose*)",
            "Bash(docker*)",
            "Bash(sleep*)",
            "Bash(dotnet clean*)",
            "Bash(dotnet format*)",
            "Bash(dotnet restore*)",
            "Bash(dotnet sln*)",
            "Bash(gh api*)",
            "Bash(gh run*)",
            "Bash(gh auth*)",
            "Bash(git reset*)",
            "Bash(git stash*)",
            "Bash(git rm*)",
            "Bash(export PATH*)",
            "Bash(echo*)",
            "Bash(date*)",
            "Bash(cat*)",
            "Bash(wc*)",
            "Bash(grep*)"
        ]
    }
}
