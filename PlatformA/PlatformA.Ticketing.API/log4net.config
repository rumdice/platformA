<?xml version="1.0" encoding="utf-8"?>
<log4net>

  <!-- 콘솔 출력 (개발 환경) -->
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss.fff} [%-5level] %logger{1} - %message%newline" />
    </layout>
  </appender>

  <!-- 파일 출력: 날짜 + 크기 기반 롤링, 최대 10개 보관 -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/ticketing-api" />
    <appendToFile value="true" />
    <rollingStyle value="Composite" />
    <datePattern value="-yyyyMMdd'.log'" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="false" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger{1} - %message%newline" />
    </layout>
  </appender>

  <!-- 루트 로거: INFO 이상 모두 출력 -->
  <root>
    <level value="INFO" />
    <appender-ref ref="ConsoleAppender" />
    <appender-ref ref="RollingFileAppender" />
  </root>

  <!-- Microsoft 프레임워크 내부 로그는 WARN 이상만 출력 (노이즈 감소) -->
  <logger name="Microsoft">
    <level value="WARN" />
  </logger>

</log4net>
