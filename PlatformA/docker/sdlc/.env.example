# PlatformA AI_SDLC Phase 3 인프라 환경변수
# 복사 방법: setup-sdlc.sh / setup-sdlc.ps1 실행 시 자동 생성됨
#            또는 수동: cp .env.example .env
# docker-compose.yml 은 같은 디렉토리의 .env 파일을 자동으로 로드합니다.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=platforma_sdlc
POSTGRES_USER=platforma
POSTGRES_PASSWORD=platforma_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 애플리케이션/스크립트용 연결 문자열 (psycopg2 / SQLAlchemy)
POSTGRES_CONNECTION_STRING=postgresql://platforma:platforma_dev_password@localhost:5432/platforma_sdlc

# .NET/npgsql용 연결 문자열
POSTGRES_CONNECTION_STRING_DOTNET=Host=localhost;Port=5432;Database=platforma_sdlc;Username=platforma;Password=platforma_dev_password

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_dev_password
N8N_HOST=localhost

# ── 프로덕션 전환 시 반드시 변경할 값 ────────────────────────────────────────
# POSTGRES_PASSWORD=<강력한 랜덤 값>
# N8N_BASIC_AUTH_PASSWORD=<강력한 랜덤 값>
