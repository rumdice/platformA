# PlatformA Docker 환경변수 설정
# 복사 방법: setup.sh / setup.ps1 실행 시 자동 생성됨
#            또는 수동: cp .env.example .env
# docker-compose.full.yml 은 같은 디렉토리의 .env 파일을 자동으로 로드합니다.

# ── MariaDB ──────────────────────────────────────────────────────────────────
# MariaDB root 계정 비밀번호. 변경 시 아래 연결 문자열도 함께 수정하세요.
MARIADB_ROOT_PASSWORD=pass1234

# ── 개발 인증서 비밀번호 ──────────────────────────────────────────────────────
# setup.sh / setup.ps1 실행 시 사용한 비밀번호와 동일해야 합니다.
CERT_PASSWORD=localdev

# ── JWT 시크릿 ────────────────────────────────────────────────────────────────
# 프로덕션 환경에서는 반드시 강력한 랜덤 값으로 변경하세요.
JWT_SECRET=YourSuperSecretKeyForPlatformAMSA!@#123

# ── 대기열 처리 속도 ──────────────────────────────────────────────────────────
QUEUE_BASE_RATE=50
QUEUE_MAX_RATE=500

# ── Snowflake ID 생성기 ───────────────────────────────────────────────────────
# 여러 Utils.API 인스턴스 실행 시 각각 고유한 값으로 설정 (1~31)
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# ── PostgreSQL (AI_SDLC 전용) ─────────────────────────────────────────────────
POSTGRES_DB=platforma_sdlc
POSTGRES_USER=platforma
POSTGRES_PASSWORD=platforma_dev_password

# ── n8n ──────────────────────────────────────────────────────────────────────
# UI: http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_dev_password
N8N_HOST=localhost
