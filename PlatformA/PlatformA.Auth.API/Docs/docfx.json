{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/*.csproj" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "**.md", "**.yml" ],
        "src": ".",
        "exclude": [ "_site/**" ]
      },
      {
        "files": [ "README.md" ],
        "src": ".."
        // 👆 상위 폴더의 README.md를 가져옵니다.
      }
    ],
    "resource": [
      {
        "files": [ "assets/**" ], // 이미지 폴더가 상위에 있다면 "src": ".." 추가 필요
        "src": ".."
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "PlatformA Auth",
      "_appTitle": "PlatformA Auth API 문서",
      "_enableSearch": true,
      "pdf": false, // 👈 에러 해결: PDF 생성 끔
      "index": "README.md" // 👈 README를 첫 화면으로 지정
    }
  }
}