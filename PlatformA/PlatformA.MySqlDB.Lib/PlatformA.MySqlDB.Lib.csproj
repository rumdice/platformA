<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlatformA.MySqlDB.Lib</RootNamespace>
    <AssemblyName>PlatformA.MySqlDB.Lib</AssemblyName>
    <!-- SDK-style 프로젝트는 AssemblyInfo를 자동 생성하므로 기존 파일과 충돌 방지 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MariaDB/MySQL EF Core 드라이버 -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <!-- snake_case 테이블·컬럼 이름 자동 변환 (MariaDB 표준 명명 규칙) -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <!-- 마이그레이션 CLI 도구 (빌드 결과물에 포함되지 않음) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Batch\*.bat" />
    <None Include="Shell\*.sh" />
    <None Include="DeployDll.bat" />
    <None Include="DeployDll.sh" />
  </ItemGroup>

</Project>
